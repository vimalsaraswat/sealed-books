# Sealed Books - Environment Configuration
# Copy this file to .env and fill in the values

# Hedera Testnet Credentials (from https://portal.hedera.com - ECDSA key required)
HEDERA_OPERATOR_ACCOUNT_ID=
HEDERA_OPERATOR_KEY=

# Privy Server Credentials (from https://dashboard.privy.io)
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Email Dispatcher via SMTP (Optional: defaults to terminal log & UI dev fallback)
# Works directly with a Google App Password (500 free emails/day)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Or standard SMTP relay:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
