# Sealed Books - Environment Configuration
# Copy this file to .env and fill in the values

# Database Configuration (Supports remote Turso/libSQL or local SQLite)
# Examples:
#   Remote Turso (Recommended for Vercel/Production serverless deployment):
#     DATABASE_URL=libsql://your-database-name.turso.io
#     TURSO_AUTH_TOKEN=your-turso-auth-token
#   Local SQLite (Default for Local Development / Desktop):
#     DATABASE_URL=data/ledger.db
#     DATABASE_URL=sqlite:///app/data/sealed_books.db
DATABASE_URL=sealed_books.db
TURSO_AUTH_TOKEN=

# Hedera Testnet Credentials (from https://portal.hedera.com - ECDSA key required)
HEDERA_OPERATOR_ACCOUNT_ID=
HEDERA_OPERATOR_KEY=
HEDERA_TOPIC_ID=0.0.10462941

# Privy Server Credentials (from https://dashboard.privy.io)
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Email Dispatcher via SMTP (Optional: defaults to terminal log & UI dev fallback)
# Works directly with a Google App Password (500 free emails/day)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Or standard SMTP relay:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
